  "descriptionCopy": {
    "ownerAttachmentSha256": "f24a85f558c3c0d9b2856edcf5af753b6fdbb72fad9a0a27494bb9d1891db6ce",
    "entriesSha256": "dc1e9b712f7782407ac8598cdf97720899b2a912c80dc564aee18e1a77af1bed",
    "entries": [
      {
        "id": "marvel-knights-to-planet-x-01",
        "sourceHeading": "Daredevil & Black Widow Opening Sequence",
        "description": "This chapter resets Daredevil with sharper emotional stakes and a grounded tone. Black Widow’s stories expand the street-level world and set up the character-driven focus of the era."
      },
      {
        "id": "marvel-knights-to-planet-x-02",
        "sourceHeading": "Punisher: Welcome Back Frank",
        "description": "Frank Castle returns with a brutal, darkly comedic take that redefines the character. The story strips him down to essentials and rebuilds his mission with clarity."
      },
      {
        "id": "marvel-knights-to-planet-x-03",
        "sourceHeading": "Marvel Boy to Early X-Men Setup",
        "description": "Marvel Boy introduces a sharp, rebellious energy that signals Marvel’s shift toward modern storytelling. Uncanny X-Men picks up that momentum with a fresh thematic direction."
      },
      {
        "id": "marvel-knights-to-planet-x-04",
        "sourceHeading": "X-Treme X-Men Launch",
        "description": "This launch pushes the X-Men into globe-spanning missions with a focus on independence and identity. It sets up a parallel spine to the main mutant titles."
      },
      {
        "id": "marvel-knights-to-planet-x-05",
        "sourceHeading": "New X-Men Begins",
        "description": "The X-Men enter a new era with bold ideas and a modern tone. The story reframes mutants as cultural icons and raises the stakes for the entire line."
      },
      {
        "id": "marvel-knights-to-planet-x-06",
        "sourceHeading": "Daredevil Companion",
        "description": "These issues deepen Matt’s emotional world and explore the cost of heroism. The tone stays grounded and personal."
      },
      {
        "id": "marvel-knights-to-planet-x-07",
        "sourceHeading": "Spider-Man: JMS Era Begins",
        "description": "Spider-Man shifts into a more introspective and mythic style. The story blends street-level challenges with larger mysteries."
      },
      {
        "id": "marvel-knights-to-planet-x-08",
        "sourceHeading": "Uncanny X-Men: Poptopia",
        "description": "The X-Men confront fame, culture, and the pressure of being public figures. The arc mixes action with social commentary."
      },
      {
        "id": "marvel-knights-to-planet-x-09",
        "sourceHeading": "Exiles Launch",
        "description": "A new team jumps across realities to fix broken timelines. The concept opens the door to constant reinvention."
      },
      {
        "id": "marvel-knights-to-planet-x-10",
        "sourceHeading": "Wolverine: Origin",
        "description": "Logan’s past is revealed with a quiet, character-focused story. It adds emotional weight to his mythology."
      },
      {
        "id": "marvel-knights-to-planet-x-11",
        "sourceHeading": "X-Treme X-Men: Savage Land",
        "description": "The team faces survival challenges in a hostile environment. The story highlights leadership and trust."
      },
      {
        "id": "marvel-knights-to-planet-x-12",
        "sourceHeading": "New X-Men: Germ-Free Generation",
        "description": "The X-Men confront biological threats and ethical dilemmas. The arc pushes the mutant metaphor into new territory."
      },
      {
        "id": "marvel-knights-to-planet-x-13",
        "sourceHeading": "Punisher: No Limits",
        "description": "Frank takes on street-level corruption with relentless focus. The story keeps the tone sharp and unforgiving."
      },
      {
        "id": "marvel-knights-to-planet-x-14",
        "sourceHeading": "X-Treme X-Men: Paradise Lost + Annual",
        "description": "The team faces political tension and moral conflict. The annual expands the stakes with a supernatural twist."
      },
      {
        "id": "marvel-knights-to-planet-x-15",
        "sourceHeading": "New X-Men: Imperial",
        "description": "The X-Men deal with cosmic politics and power struggles. The arc raises the scale without losing emotional focus."
      },
      {
        "id": "marvel-knights-to-planet-x-16",
        "sourceHeading": "Uncanny X-Men: X-Corps (Prelude)",
        "description": "The team faces internal fractures and shifting alliances. The setup builds toward a larger conflict."
      },
      {
        "id": "marvel-knights-to-planet-x-17",
        "sourceHeading": "Hulk: Return of the Monster",
        "description": "Bruce confronts the monster within through a tense, psychological story. The tone is quiet, eerie, and character-driven."
      },
      {
        "id": "marvel-knights-to-planet-x-18",
        "sourceHeading": "Exiles: A World Apart",
        "description": "The team faces a reality that challenges their core values. The arc tests loyalty and purpose."
      },
      {
        "id": "marvel-knights-to-planet-x-19",
        "sourceHeading": "Punisher: Do Not Fall in New York City",
        "description": "Frank deals with the fallout of urban decay. The story keeps the focus tight and personal."
      },
      {
        "id": "marvel-knights-to-planet-x-20",
        "sourceHeading": "Daredevil: Underboss",
        "description": "Matt faces a power shift in the criminal underworld. The arc sets up long-term consequences."
      },
      {
        "id": "marvel-knights-to-planet-x-21",
        "sourceHeading": "Spider-Man: Revelations",
        "description": "Peter confronts hidden truths that reshape his relationships. The tone is emotional and reflective."
      },
      {
        "id": "marvel-knights-to-planet-x-22",
        "sourceHeading": "Uncanny X-Men: X-Corps (Main Arc)",
        "description": "The X-Men face a dangerous new mutant organization. The story blends political tension with action."
      },
      {
        "id": "marvel-knights-to-planet-x-23",
        "sourceHeading": "X-Treme X-Men: Invasion",
        "description": "The team responds to a global threat with high stakes. The arc emphasizes teamwork and resilience."
      },
      {
