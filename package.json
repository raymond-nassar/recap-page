{
  "name": "recap-page",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "Local, private reading-order tracker that deep-links into the Marvel Unlimited web reader.",
  "license": "MIT",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "contract": "node scripts/check-contract.mjs",
    "cbh:prepare": "node scripts/prepare-cbh-batch.mjs",
    "cbh:resolve": "node scripts/resolve-cbh-order.mjs",
    "cbro:prepare": "node scripts/prepare-cbro-event.mjs",
    "cbro:freeze": "node scripts/freeze-cbro-timeline-ranges.mjs",
    "cbro:approve": "node scripts/author-cbro-packet.mjs --approve",
    "cbro:author": "node scripts/author-cbro-packet.mjs --author",
    "orders:overlap": "node scripts/report-order-overlap.mjs",
    "owner:intake": "node scripts/owner-guide.mjs intake",
    "owner:prepare": "node scripts/owner-guide.mjs prepare",
    "owner:author": "node scripts/owner-guide.mjs author",
    "owner:vendor": "node scripts/owner-guide.mjs vendor",
    "owner:check": "node scripts/owner-guide.mjs check",
    "owner:phase": "node scripts/owner-guide.mjs phase",
    "owner:finish": "node scripts/owner-guide.mjs finish",
    "anchors": "node scripts/check-anchors.mjs",
    "anchors:bless": "node scripts/check-anchors.mjs --bless",
    "counts": "node scripts/check-counts.mjs",
    "sizes": "node scripts/check-sizes.mjs",
    "spacing": "node scripts/check-spacing.mjs",
    "palette": "node scripts/check-palette.mjs",
    "publication": "node scripts/check-publication.mjs",
    "publication:preflight": "node scripts/check-publication.mjs --preflight",
    "publication:surface": "node scripts/check-publication.mjs --surface",
    "publication:branches": "node scripts/check-publication.mjs --branches",
    "vendor": "node scripts/vendor-orders.mjs",
    "vendor:index": "node scripts/vendor-index.mjs",
    "icons": "node scripts/build-icons.mjs",
    "pack": "node scripts/pack-windows.mjs",
    "msix:pack": "node scripts/pack-msix.mjs",
    "msix:inspect": "node scripts/inspect-msix.mjs",
    "msix:prove": "node scripts/msix-proof.mjs",
    "store:assets": "node scripts/capture-store-assets.mjs",
    "play:assets": "node scripts/capture-play-assets.mjs",
    "store:check": "node scripts/check-store-submission.mjs",
    "browser": "node scripts/browser-check.mjs",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:browser": "node scripts/browser-android.mjs",
    "browser:prove": "node scripts/browser-check.mjs --prove",
    "upgrade": "node scripts/upgrade-check.mjs",
    "upgrade:prove": "node scripts/upgrade-check.mjs --prove",
    "home-updates": "node scripts/generate-home-updates.mjs",
    "home-updates:check": "node scripts/generate-home-updates.mjs --check --recorded",
    "version": "node scripts/sync-version.mjs && node scripts/generate-home-updates.mjs --candidate && git add src/js/lib/version.js src/js/lib/homeUpdatesContent.js",
    "pages:build": "node scripts/build-pages.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0"
  }
}
